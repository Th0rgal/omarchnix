+        let mut wait = AWDL_SYN_STAGGER;
+        if let Some(t) = last_launch
+            && pending.len() < AWDL_SYN_MAX_PENDING
+        {
+            wait = wait.min(AWDL_SYN_STAGGER.saturating_sub(now.saturating_duration_since(t)));
+        }
+        if let Some(d) = deadline {
+            wait = wait.min(d.saturating_duration_since(now));
+        }
+        let poll_ms = libc::c_int::try_from(wait.as_millis().max(1)).unwrap_or(50);
+
+        let mut pfds: Vec<libc::pollfd> = pending
+            .iter()
+            .map(|(fd, _)| libc::pollfd {
+                fd: fd.as_raw_fd(),
+                events: libc::POLLOUT,
+                revents: 0,
+            })
+            .collect();
+        // SAFETY: `pfds` is a valid contiguous slice of pollfd structs.
+        let ready = unsafe { libc::poll(pfds.as_mut_ptr(), pfds.len() as libc::nfds_t, poll_ms) };
+        if ready < 0 {
+            let e = io::Error::last_os_error();
+            if e.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return Err(e);
+        }
+        if ready == 0 {
+            continue;
+        }
+
+        let mut idx = 0;
+        while idx < pfds.len() {
+            if pfds[idx].revents == 0 {
+                idx += 1;
+                continue;
+            }
+            let err = so_error(&pending[idx].0)?;
+            if err == 0 {
+                let (fd, _) = pending.swap_remove(idx);
