+/// phase-locks onto non-overlapping slots on Broadcom firmware and causes
+/// 100% connect timeouts when the peer only overlaps on social channel 6).
+pub fn connect_awdl(addr: &SocketAddr, timeout: Option<Duration>) -> io::Result<TcpStream> {
+    let Some(v6) = is_awdl_link_local(addr) else {
+        return match timeout {
+            Some(t) => TcpStream::connect_timeout(addr, t),
+            None => TcpStream::connect(addr),
+        };
+    };
+    let deadline = timeout.map(|t| Instant::now() + t);
+    let mut pending: Vec<(OwnedFd, Instant)> = Vec::with_capacity(AWDL_SYN_MAX_PENDING);
+    let mut last_launch: Option<Instant> = None;
+    let mut last_err: Option<i32> = None;
+
+    loop {
+        let now = Instant::now();
+        if let Some(d) = deadline
+            && now >= d
+        {
+            return Err(match last_err {
+                Some(e) if e != libc::ETIMEDOUT => io::Error::from_raw_os_error(e),
+                _ => io::Error::new(io::ErrorKind::TimedOut, "connection timed out"),
+            });
+        }
