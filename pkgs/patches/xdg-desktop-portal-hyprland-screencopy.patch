+void CPipewireConnection::disconnectCore() {
+    if (!m_pCore)
+        return;
+
+    while (!m_vStreams.empty()) {
+        const auto SESSION = m_vStreams.back()->pSession;
+        if (SESSION && SESSION->sharingData.active)
+            destroyStream(SESSION);
+        else {
+            if (m_vStreams.back()->stream)
+                pw_stream_destroy(m_vStreams.back()->stream);
+            m_vStreams.pop_back();
+        }
+    }
+
+    spa_hook_remove(&m_coreListener);
+    spa_zero(m_coreListener);
+    pw_core_disconnect(m_pCore);
+    m_pCore     = nullptr;
+    m_bCoreDead = false;
 }
 
