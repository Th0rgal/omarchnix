#!/usr/bin/env bash

# omarchy:summary=Set and remember the power profile for AC or battery use
# omarchy:args=[--ephemeral] [autodetect|ac|battery] [power-saver|balanced|performance]

ephemeral=false
if [[ ${1:-} == "--ephemeral" ]]; then
  ephemeral=true
  shift
fi

action="${1:-autodetect}"
requested_profile="${2:-}"

usage() {
  echo "Usage: omarchy-powerprofiles-set [--ephemeral] [autodetect|ac|battery] [power-saver|balanced|performance]" >&2
  exit 1
}

(( $# <= 2 )) || usage

case "$action" in
  autodetect)
    # Use the same signal as the shell (UPower.onBattery) so every entry point
    # saves and restores the profile under the same ac/battery key.
    if [[ $(busctl get-property org.freedesktop.UPower /org/freedesktop/UPower org.freedesktop.UPower OnBattery 2>/dev/null) == "b true" ]]; then
      action=battery
    else
      action=ac
    fi
    ;;
  ac | battery) ;;
  *) usage ;;
esac

mapfile -t profiles < <(omarchy-powerprofiles-list)

profile_available() {
  [[ " ${profiles[*]} " == *" $1 "* ]]
}

is_sidesystem=false
if [[ -w /var/lib/sidesystem/power-profile-req ]]; then
  is_sidesystem=true
fi

is_apple_cpufreq=false
if [[ -r /sys/devices/system/cpu/cpufreq/policy0/scaling_driver ]] &&
   [[ $(</sys/devices/system/cpu/cpufreq/policy0/scaling_driver) == "apple-cpufreq" ]]; then
  is_apple_cpufreq=true
fi

state_dir="${OMARCHY_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/powerprofiles}"
state_file="$state_dir/$action"

if [[ -n $requested_profile ]]; then
  profile_available "$requested_profile" || {
    echo "Power profile is not available: $requested_profile" >&2
    exit 1
  }

  profile="$requested_profile"
elif [[ -r $state_file ]]; then
  profile=$(<"$state_file")
fi

if [[ -z ${profile:-} ]] || ! profile_available "$profile"; then
  if [[ $is_apple_cpufreq == "true" ]]; then
    # Default fanless Apple Silicon Macs to cool, silent Balanced mode on both
    # AC and battery until the user explicitly chooses Power-saver or Performance.
    profile=balanced
  elif [[ $action == "ac" ]] && profile_available performance; then
    profile=performance
  else
    profile=balanced
  fi
fi

pick_freq_le() {
  local limit="$1"
  shift
  local best="" f
  for f in "$@"; do
    [[ $f =~ ^[0-9]+$ ]] || continue
    if (( f <= limit )); then
      best="$f"
    fi
  done
  [[ -n $best ]] || best="${1:-}"
  printf '%s' "$best"
}

pick_freq_max() {
  local best="" f
  for f in "$@"; do
    [[ $f =~ ^[0-9]+$ ]] || continue
    if [[ -z $best ]] || (( f > best )); then
      best="$f"
    fi
  done
  printf '%s' "$best"
}

set_ppd_profile() {
  local ppd_target="$1"
  # Prefer native D-Bus busctl over PyGObject `powerprofilesctl` to avoid
  # spawning Python 3.14 (and its GLib worker shutdown race) on every transition.
  if command -v busctl >/dev/null 2>&1; then
    busctl set-property \
      net.hadess.PowerProfiles \
      /net/hadess/PowerProfiles \
      net.hadess.PowerProfiles \
      ActiveProfile s "$ppd_target" >/dev/null 2>&1 && return 0
  fi
  powerprofilesctl set "$ppd_target" >/dev/null 2>&1 || true
}

apply_apple_silicon_profile() {
  local target="$1"
  local source_mode="$2"
  local ppd_profile="balanced"
  [[ $target == "power-saver" ]] && ppd_profile="power-saver"

  # Notify power-profiles-daemon so Chromium/Helium/Electron PowerMonitor and
  # GLib GPowerProfileMonitor clients toggle background Energy Saver timers.
  set_ppd_profile "$ppd_profile"

  # 1. CPU cluster P-states & Avalanche boost calibrated to M2 (T8112) V/F Pareto knees:
  # - `power-saver`: E<=2256 MHz (peak 3,421 ev/J) + P<=1968 MHz (peak 7,058 ev/J, <4.9W SoC)
  #   gives 3.4x faster 1-thread responsiveness and +12.5% better Joules/task than E-only 2004 MHz.
  # - `balanced` (battery): E<=2424 MHz + P<=2400 MHz (peak 1-thread 2,448 ev/J @ 3.25W SoC,
  #   78% of max 8-core speed at 54% of SoC power).
  # - `balanced` (AC): E<=2424 MHz + P<=3204 MHz, boost=0 (100% multi-core speed without boost Vmax tax).
  # - `performance`: E<=2424 MHz + P<=3504 MHz, boost=1 (maximum single-core burst + unclamped builds).
  local boost_path="/sys/devices/system/cpu/cpufreq/boost"
  if [[ $target == "performance" ]]; then
    [[ -w $boost_path ]] && printf '1\n' >"$boost_path" 2>/dev/null || true
  else
    [[ -w $boost_path ]] && printf '0\n' >"$boost_path" 2>/dev/null || true
  fi

  local pol first_cpu cap avail_raw boost_raw target_khz
  for pol in /sys/devices/system/cpu/cpufreq/policy*; do
    [[ -w "$pol/scaling_max_freq" && -r "$pol/scaling_available_frequencies" ]] || continue
    read -r first_cpu _ <"$pol/related_cpus"
    cap=1024
    if [[ -r "/sys/devices/system/cpu/cpu${first_cpu}/cpu_capacity" ]]; then
      cap=$(<"/sys/devices/system/cpu/cpu${first_cpu}/cpu_capacity")
    fi
    read -r -a avail_raw <"$pol/scaling_available_frequencies"
    boost_raw=()
    [[ -r "$pol/scaling_boost_frequencies" ]] && read -r -a boost_raw <"$pol/scaling_boost_frequencies"

    target_khz=""
    if (( cap < 1024 )); then
      # Blizzard / Sawtooth efficiency cluster
      if [[ $target == "power-saver" ]]; then
        target_khz=$(pick_freq_le 2260000 "${avail_raw[@]}")
      else
        target_khz=$(pick_freq_max "${avail_raw[@]}")
      fi
    else
      # Avalanche / Everest performance cluster
      case "$target" in
        power-saver)
          target_khz=$(pick_freq_le 2000000 "${avail_raw[@]}")
          ;;
        balanced)
          if [[ $source_mode == "battery" ]]; then
            target_khz=$(pick_freq_le 2410000 "${avail_raw[@]}")
          else
            target_khz=$(pick_freq_max "${avail_raw[@]}")
          fi
          ;;
        performance)
          if (( ${#boost_raw[@]} > 0 )); then
            target_khz=$(pick_freq_max "${avail_raw[@]}" "${boost_raw[@]}")
          else
            target_khz=$(pick_freq_max "${avail_raw[@]}")
          fi
          ;;
      esac
    fi

    if [[ -n $target_khz ]]; then
      printf '%s\n' "$target_khz" >"$pol/scaling_max_freq" 2>/dev/null || true
    fi
  done

  # 2. Kernel Energy Aware Scheduler (EAS) utilization clamps:
  # Never clamp interactive `app.slice` (which would throttle 1-thread UI/CLI bursts
  # by 5.5x and violate race-to-idle); steer `background.slice` and `nix-daemon`
  # onto Blizzard E-cores (`50% < 55.76%` capacity), unclamping `nix-daemon` in Performance.
  local uid
  uid=$(id -u)
  local app_uclamp="/sys/fs/cgroup/user.slice/user-${uid}.slice/user@${uid}.service/app.slice/cpu.uclamp.max"
  if [[ -w $app_uclamp ]]; then
    printf 'max\n' >"$app_uclamp" 2>/dev/null || true
  fi

  local bg_uclamp="/sys/fs/cgroup/user.slice/user-${uid}.slice/user@${uid}.service/background.slice/cpu.uclamp.max"
  if [[ -w $bg_uclamp ]]; then
    if [[ $target == "power-saver" || ( $target == "balanced" && $source_mode == "battery" ) ]]; then
      printf '50.00\n' >"$bg_uclamp" 2>/dev/null || true
    else
      printf 'max\n' >"$bg_uclamp" 2>/dev/null || true
    fi
  fi

  local nix_uclamp="/sys/fs/cgroup/system.slice/nix-daemon.service/cpu.uclamp.max"
  if [[ -w $nix_uclamp ]]; then
    if [[ $target == "performance" ]]; then
      printf 'max\n' >"$nix_uclamp" 2>/dev/null || true
    else
      printf '50.00\n' >"$nix_uclamp" 2>/dev/null || true
    fi
  fi

  # 3. Hyprland compositor GPU bandwidth tuning (1-pass saver, 2-pass battery balanced, 3-pass AC).
  local rt_dir="${XDG_RUNTIME_DIR:-/run/user/${uid}}"
  local sig="${HYPRLAND_INSTANCE_SIGNATURE:-}"
  if [[ -z $sig ]] && command -v hyprctl >/dev/null 2>&1 && [[ -d "$rt_dir/hypr" ]]; then
    sig=$(XDG_RUNTIME_DIR="$rt_dir" hyprctl instances -j 2>/dev/null | jq -r '.[0].instance // empty' 2>/dev/null || true)
  fi
  if [[ -n $sig ]] && command -v hyprctl >/dev/null 2>&1; then
    local blur_passes=3
    if [[ $target == "power-saver" ]]; then
      blur_passes=1
    elif [[ $target == "balanced" && $source_mode == "battery" ]]; then
      blur_passes=2
    fi
    XDG_RUNTIME_DIR="$rt_dir" HYPRLAND_INSTANCE_SIGNATURE="$sig" \
      hyprctl --quiet eval "hl.config({ decoration = { blur = { passes = ${blur_passes} } } })" >/dev/null 2>&1 || true
  fi
}

mkdir -p "$state_dir"
if [[ $is_sidesystem == "true" ]]; then
  printf '%s\n' "$profile" > /var/lib/sidesystem/power-profile-req 2>/dev/null || true
  printf '%s\n' "$profile" > "$state_dir/active"
elif [[ $is_apple_cpufreq == "true" ]]; then
  apply_apple_silicon_profile "$profile" "$action"
  printf '%s\n' "$profile" >"$state_dir/active"
else
  set_ppd_profile "$profile"
  printf '%s\n' "$profile" >"$state_dir/active"
fi

if [[ -n $requested_profile && $ephemeral != "true" ]]; then
  printf '%s\n' "$requested_profile" >"$state_file"
fi

omarchy-shell -q battery refreshPowerProfile >/dev/null 2>&1 || true
omarchy-shell -q omarchy.power refresh >/dev/null 2>&1 || true
