+/// Best-effort TCP retransmission cap for AWDL link-local sockets so data
+/// segments do not back off into multi-minute blackouts or phase-lock to the
+/// 1.0486 s AWDL slot cycle.
+fn tune_awdl_tcp(sock: &TcpStream) {
+    let set = |opt: libc::c_int, val: libc::c_int| -> bool {
+        // SAFETY: valid live socket fd and stack-local c_int.
+        unsafe {
+            libc::setsockopt(
+                sock.as_raw_fd(),
+                libc::IPPROTO_TCP,
+                opt,
+                (&raw const val).cast(),
+                size_of::<libc::c_int>() as libc::socklen_t,
+            ) == 0
+        }
+    };
+    if set(libc::TCP_USER_TIMEOUT, AWDL_USER_TIMEOUT_MS) && !set(TCP_RTO_MAX_MS, AWDL_RTO_MAX_MS) {
+        let _ = set(libc::TCP_USER_TIMEOUT, 0);
+    }
