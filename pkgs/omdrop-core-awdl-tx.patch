+        let due_for_launch = pending.is_empty()
+            || (pending.len() < AWDL_SYN_MAX_PENDING
+                && last_launch.is_none_or(|t| now.saturating_duration_since(t) >= AWDL_SYN_STAGGER));
+        if due_for_launch {
+            match start_nonblocking_v6(v6) {
+                Ok((fd, true)) => {
+                    set_blocking(&fd)?;
+                    let sock = TcpStream::from(fd);
+                    tune_awdl_tcp(&sock);
+                    return Ok(sock);
+                }
+                Ok((fd, false)) => {
+                    pending.push((fd, now));
+                    last_launch = Some(now);
+                }
+                Err(e) => {
+                    // Immediate local/stack refusal or routing error.
+                    if pending.is_empty()
+                        || matches!(
+                            e.raw_os_error(),
+                            Some(libc::ECONNREFUSED | libc::ENETUNREACH | libc::EINVAL)
+                        )
+                    {
+                        return Err(e);
+                    }
+                    last_err = e.raw_os_error();
+                    last_launch = Some(now);
+                }
+            }
+        }
