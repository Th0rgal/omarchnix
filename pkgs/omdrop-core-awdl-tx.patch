+        // Expire old pending attempts so the kernel stops phase-locked SYN
+        // retransmits, while keeping at least one socket alive near deadline.
+        let can_launch_more = deadline.is_none_or(|d| d.saturating_duration_since(now) > AWDL_SYN_STAGGER);
+        if can_launch_more || pending.len() > 1 {
+            pending.retain(|(_, started)| now.saturating_duration_since(*started) < AWDL_SYN_LIFETIME);
+        }
