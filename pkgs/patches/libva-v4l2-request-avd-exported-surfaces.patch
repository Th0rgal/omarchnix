+static void dmabuf_sync(int fd, uint64_t flags)
+{
+	struct dma_buf_sync sync = { .flags = flags };
+
+	if (fd < 0)
+		return;
+	while (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) < 0 &&
+	       (errno == EINTR || errno == EAGAIN))
+		;
+}
+
+/* Base pointer and pitch of plane @plane (0 = luma, 1 = chroma) of a linear
+ * NV12/P010 view, contiguous or with one memory plane per component. */
+static uint8_t *linear_plane(const struct v4l2r_frame_view *view,
+			     unsigned int plane, int *fd)
+{
+	if (view->nb_planes >= 2) {
+		*fd = view->dmabuf_fd[plane];
+		return view->map[plane];
+	}
+	*fd = view->dmabuf_fd[0];
+	return (uint8_t *)view->map[0] +
+	       (plane ? (size_t)view->pitch * view->height : 0);
+}
+
+VAStatus v4l2r_surface_publish_backing(struct v4l2r_surface *surface)
+{
+	struct v4l2r_surface_backing *backing = surface->backing;
+	struct v4l2r_frame_view src, dst;
+	VAStatus status;
+
+	if (!backing || !backing->exported || !surface->ctx ||
+	    surface->ctx->conv || surface->capture_index < 0)
+		return VA_STATUS_SUCCESS;
+
+	uint64_t t0 = v4l2r_now_ns();
+
+	status = v4l2r_sync_capture(surface->ctx, surface->capture_index);
+	if (status != VA_STATUS_SUCCESS)
+		return status;
+
+	status = v4l2r_surface_capture_view(surface, true, &src);
+	if (status != VA_STATUS_SUCCESS)
+		return status;
+
+	memset(&dst, 0, sizeof(dst));
+	dst.info = v4l2r_format_by_pixelformat(backing->pixelformat);
+	dst.pixelformat = backing->pixelformat;
+	dst.width = backing->width;
+	dst.height = backing->height;
+	dst.pitch = backing->pitch;
+	dst.nb_planes = backing->nb_planes;
+	for (unsigned int i = 0; i < backing->nb_planes; i++) {
+		if (!backing->map[i]) {
+			void *addr = mmap(NULL, backing->plane_size[i],
+					  PROT_READ | PROT_WRITE, MAP_SHARED,
+					  backing->dmabuf_fd[i], 0);
+			if (addr == MAP_FAILED)
+				return VA_STATUS_ERROR_OPERATION_FAILED;
+			backing->map[i] = addr;
+		}
+		dst.map[i] = backing->map[i];
+		dst.dmabuf_fd[i] = backing->dmabuf_fd[i];
+		dst.plane_size[i] = backing->plane_size[i];
+	}
+
+	/* Only plain linear 4:2:0 layouts of the same format are copied. */
+	if (!src.info || !dst.info ||
+	    src.info->drm_format != dst.info->drm_format ||
+	    src.info->drm_modifier != DRM_FORMAT_MOD_LINEAR ||
+	    dst.info->drm_modifier != DRM_FORMAT_MOD_LINEAR ||
+	    (src.info->drm_format != DRM_FORMAT_NV12 &&
+	     src.info->drm_format != DRM_FORMAT_P010))
+		return VA_STATUS_ERROR_UNSUPPORTED_RT_FORMAT;
+
+	uint32_t rows = src.height < dst.height ? src.height : dst.height;
+	uint32_t row_bytes = src.pitch < dst.pitch ? src.pitch : dst.pitch;
+
+	for (unsigned int p = 0; p < 2; p++) {
+		int sfd, dfd;
+		uint8_t *s = linear_plane(&src, p, &sfd);
+		uint8_t *d = linear_plane(&dst, p, &dfd);
+		uint32_t n = p ? (rows + 1) / 2 : rows;
+
+		dmabuf_sync(sfd, DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+		dmabuf_sync(dfd, DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE);
+		if (src.pitch == dst.pitch) {
+			memcpy(d, s, (size_t)src.pitch * n);
+		} else {
+			for (uint32_t y = 0; y < n; y++)
+				memcpy(d + (size_t)y * dst.pitch,
+				       s + (size_t)y * src.pitch, row_bytes);
+		}
+		dmabuf_sync(dfd, DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE);
+		dmabuf_sync(sfd, DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+	}
+
+	v4l2r_trace("publish surface 0x%08x buf #%d -> exported backing: "
+		    "%.2f ms\n", surface->id, surface->capture_index,
+		    (v4l2r_now_ns() - t0) / 1e6);
+	return VA_STATUS_SUCCESS;
+}
