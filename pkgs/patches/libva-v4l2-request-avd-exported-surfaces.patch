+/*
+ * VA surfaces outlive the context that decoded into them: a client may keep
+ * showing (or read back) a frame after vaDestroyContext(), e.g. across a
+ * resolution change or at end of stream. Before the CAPTURE pool is torn
+ * down, finish every decode still bound to a surface and hand the buffer's
+ * dma-buf over to the surface as standalone backing. The exported dma-buf
+ * keeps the vb2 memory alive after STREAMOFF and close(), so the pixels stay
+ * valid; without this the surface fell back to fresh zeroed backing, which
+ * shows as a green frame.
+ */
+static void preserve_bound_surfaces(struct v4l2r_context *ctx)
+{
+	for (unsigned int i = 0; i < ctx->nb_captures; i++) {
+		struct v4l2r_capture_buffer *capture = &ctx->captures[i];
+		struct v4l2r_surface *surface = capture->surface;
+		struct v4l2r_surface_backing *backing;
+		struct v4l2r_frame_view view;
+
+		if (!surface || surface->capture_index != (int)i)
+			continue;
+
+		/* Submit any held frame, wait for the decode and conversion. */
+		if (v4l2r_surface_ready(surface) != VA_STATUS_SUCCESS)
+			continue;
+
+		/* With a conversion chain the client-visible pixels already
+		 * live in the surface's own backing. */
+		if (ctx->conv || surface->backing)
+			continue;
+
+		if (v4l2r_surface_capture_view(surface, false, &view) !=
+		    VA_STATUS_SUCCESS)
+			continue;
+
+		backing = calloc(1, sizeof(*backing));
+		if (!backing)
+			continue;
+
+		backing->pixelformat = view.pixelformat;
+		backing->width = view.width;
+		backing->height = view.height;
+		backing->pitch = view.pitch;
+		backing->nb_planes = view.nb_planes;
+		for (unsigned int p = 0; p < VIDEO_MAX_PLANES; p++)
+			backing->dmabuf_fd[p] = -1;
+		for (unsigned int p = 0; p < view.nb_planes; p++) {
+			backing->plane_size[p] = view.plane_size[p];
+			/* Steal the fd; capture_buffer_cleanup() skips -1. */
+			backing->dmabuf_fd[p] = capture->dmabuf_fd[p];
+			capture->dmabuf_fd[p] = -1;
+		}
+
+		surface->backing = backing;
+		v4l2r_trace("preserve surface 0x%08x: CAPTURE buffer #%u "
+			    "handed over as standalone backing\n",
+			    surface->id, i);
+	}
+}
